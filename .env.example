APP_NAME=BrioCampus API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

DATABASE_URL=mysql+pymysql://root:root@localhost:3307/briocampus

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

JWT_SECRET=change-me-briocampus-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

LOG_RETENTION_DAYS=90
LOG_ARCHIVE_AFTER_DAYS=30

UPLOAD_DIR=uploads/palmares
MAX_UPLOAD_SIZE_MB=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@briocampus.local
SMTP_TLS=true
